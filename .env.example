# Copier en .env puis exporter (ex: `set -a; source .env; set +a`).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optionnel : par defaut ./openfold-3-mlx et ./var/jobs
# OPENFOLD_PROJECT_DIR=/chemin/vers/openfold-3-mlx
# OPENFOLD_PYTHON=/chemin/vers/openfold-3-mlx/.venv/bin/python3
# OPENFOLD_RUNNER_YAML=/chemin/vers/mlx_runner.yml
# OPENFOLD_JOBS_DIR=/chemin/vers/jobs
