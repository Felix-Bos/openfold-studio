# Copy to .env, then load it before starting the app: `set -a; source .env; set +a`

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Paris
# DJANGO_DB_PATH=/path/to/db.sqlite3               # default: var/db.sqlite3

# OpenFold3-MLX (defaults: ./openfold-3-mlx and ./var/jobs)
# OPENFOLD_PROJECT_DIR=/path/to/openfold-3-mlx
# OPENFOLD_PYTHON=/path/to/openfold-3-mlx/.venv/bin/python3
# OPENFOLD_RUNNER_YAML=/path/to/mlx_runner.yml
# OPENFOLD_JOBS_DIR=/path/to/jobs
